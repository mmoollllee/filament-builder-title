{
    "name": "mmoollllee/filament-builder-title",
    "description": "Editable title input in Filament Builder block headers",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filamentphp",
        "laravel",
        "builder",
        "block",
        "title",
        "inline-edit"
    ],
    "authors": [
        {
            "name": "Moritz Graf",
            "email": "mg@moritz-graf.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentBuilderTitle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmoollllee\\FilamentBuilderTitle\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "filament/filament": "^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentBuilderTitle\\FilamentBuilderTitleServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    }
}